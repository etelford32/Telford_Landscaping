# Environment Variables Template
# Copy this file to .env.local for local development

# JWT Secret for Authentication (REQUIRED - change in production)
JWT_SECRET=your-secret-key-change-in-production

# Google Analytics (Optional - for tracking website analytics)
# Get your measurement ID from https://analytics.google.com
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Future: Stripe API Keys (for PRO subscriptions)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# Future: Email Service (SendGrid/AWS SES)
# SENDGRID_API_KEY=
# EMAIL_FROM=info@telfordlandscaping.com

# Future: Database (PostgreSQL)
# DATABASE_URL=

# Future: Authentication (NextAuth)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=

# Future: AWS S3 (for image uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
