# Environment Variables Template
# Copy this file to .env.local for local development

# Future: Stripe API Keys (for PRO subscriptions)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=

# Future: Email Service (SendGrid/AWS SES)
# SENDGRID_API_KEY=
# EMAIL_FROM=info@telfordlandscapes.com

# Future: Database (PostgreSQL)
# DATABASE_URL=

# Future: Authentication (NextAuth)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=

# Future: AWS S3 (for image uploads)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
